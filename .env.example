# ─────────────────────────────────────────────────────────────────
# Bitpanda-Integration (Self-Run-Tool)
#
# Kopiere diese Datei nach `.env` und trage deine Werte ein.
# `.env` ist gitignored – dein API-Key wird NIE eingecheckt.
#
# Sicherheits-Haltung: Standardmäßig ist Trading AUS und Dry-Run AN.
# Echtes Traden aktivierst nur DU bewusst über die Schalter unten.
# ─────────────────────────────────────────────────────────────────

# Dein Bitpanda-API-Key (Exchange/Fusion). Read-only genügt, solange
# du Trading nicht aktivierst. Niemals teilen, niemals committen.
BITPANDA_API_KEY=

# Base-URL der API. Default = Bitpanda Exchange/Fusion.
# Gegen deine eigene Bitpanda-API-Doku/deinen Key-Typ verifizieren.
BITPANDA_API_URL=https://api.exchange.bitpanda.com/public/v1

# Master-Schalter für echtes Traden. true = Orders dürfen gesendet werden.
# Default: false (nur Read-only + Vorschau).
BITPANDA_TRADING_ENABLED=false

# Dry-Run: simuliert Orders statt sie zu senden. Default: true.
# Auf false setzen, wenn echte Orders rausgehen sollen (zusammen mit TRADING_ENABLED=true).
BITPANDA_DRY_RUN=true

# Not-Aus. true = blockt jede Order, unabhängig von allen anderen Schaltern.
BITPANDA_KILL_SWITCH=false

# Guardrail: maximaler EUR-Gegenwert pro Order.
BITPANDA_MAX_ORDER_EUR=100

# Quote-Währung für EUR-Schätzungen (Instrumente wie BTC_EUR).
BITPANDA_QUOTE_CURRENCY=EUR
