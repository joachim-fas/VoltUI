/**
 * GrainChart – Atmospheric Grain Design System
 * Diagramm-Komponenten mit Grain-Farbpalette (Recharts).
 */

import React from "react";
import { cn } from "@/lib/utils";
import {
  AreaChart, Area, BarChart, Bar,
  LineChart, Line, PieChart, Pie, Cell,
  XAxis, YAxis, CartesianGrid, Tooltip,
  ResponsiveContainer, Legend,
} from "recharts";

/* ── Grain Color Palette für Charts ── */
export const GRAIN_CHART_COLORS = [
  "oklch(0.42 0.22 268)",   // blue
  "oklch(0.52 0.26 27)",    // red
  "oklch(0.36 0.20 285)",   // violet
  "oklch(0.68 0.18 28)",    // coral
  "oklch(0.62 0.16 268)",   // light blue
  "oklch(0.55 0.18 145)",   // green
];

/* ── Custom Tooltip ── */
const CustomTooltip = ({ active, payload, label }: {
  active?: boolean;
  payload?: Array<{ name: string; value: number; color: string }>;
  label?: string;
}) => {
  if (!active || !payload?.length) return null;
  return (
    <div className="glass-strong rounded-xl px-3 py-2.5 shadow-lg border border-border/50">
      {label && <p className="text-xs font-mono text-muted-foreground mb-1">{label}</p>}
      {payload.map((p, i) => (
        <div key={i} className="flex items-center gap-2">
          <span
            className="w-2 h-2 rounded-full flex-shrink-0"
            style={{ backgroundColor: p.color }}
          />
          <span className="text-xs font-body font-semibold text-foreground">
            {p.name}: <span className="font-mono">{p.value}</span>
          </span>
        </div>
      ))}
    </div>
  );
};

/* ── GrainAreaChart ── */
export interface GrainAreaChartProps extends React.HTMLAttributes<HTMLDivElement> {
  data: Record<string, unknown>[];
  dataKeys: string[];
  xKey: string;
  height?: number;
  title?: string;
  gradient?: boolean;
}

export const GrainAreaChart: React.FC<GrainAreaChartProps> = ({
  data, dataKeys, xKey, height = 220, title, gradient = true, className, ...props
}) => (
  <div className={cn("w-full", className)} {...props}>
    {title && <p className="text-sm font-semibold font-body text-foreground mb-3">{title}</p>}
    <ResponsiveContainer width="100%" height={height}>
      <AreaChart data={data} margin={{ top: 4, right: 4, left: -20, bottom: 0 }}>
        <defs>
          {dataKeys.map((key, i) => (
            <linearGradient key={key} id={`grain-area-${key}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="5%"  stopColor={GRAIN_CHART_COLORS[i % GRAIN_CHART_COLORS.length]} stopOpacity={0.35} />
              <stop offset="95%" stopColor={GRAIN_CHART_COLORS[i % GRAIN_CHART_COLORS.length]} stopOpacity={0.02} />
            </linearGradient>
          ))}
        </defs>
        <CartesianGrid strokeDasharray="3 3" stroke="oklch(0.88 0.015 268 / 0.5)" vertical={false} />
        <XAxis dataKey={xKey} tick={{ fontSize: 11, fontFamily: "JetBrains Mono", fill: "oklch(0.52 0.06 268)" }} axisLine={false} tickLine={false} />
        <YAxis tick={{ fontSize: 11, fontFamily: "JetBrains Mono", fill: "oklch(0.52 0.06 268)" }} axisLine={false} tickLine={false} />
        <Tooltip content={<CustomTooltip />} />
        {dataKeys.map((key, i) => (
          <Area
            key={key}
            type="monotone"
            dataKey={key}
            stroke={GRAIN_CHART_COLORS[i % GRAIN_CHART_COLORS.length]}
            strokeWidth={2}
            fill={gradient ? `url(#grain-area-${key})` : "transparent"}
            dot={false}
            activeDot={{ r: 4, strokeWidth: 2, stroke: "white" }}
          />
        ))}
      </AreaChart>
    </ResponsiveContainer>
  </div>
);

/* ── GrainBarChart ── */
export interface GrainBarChartProps extends React.HTMLAttributes<HTMLDivElement> {
  data: Record<string, unknown>[];
  dataKeys: string[];
  xKey: string;
  height?: number;
  title?: string;
  stacked?: boolean;
}

export const GrainBarChart: React.FC<GrainBarChartProps> = ({
  data, dataKeys, xKey, height = 220, title, stacked = false, className, ...props
}) => (
  <div className={cn("w-full", className)} {...props}>
    {title && <p className="text-sm font-semibold font-body text-foreground mb-3">{title}</p>}
    <ResponsiveContainer width="100%" height={height}>
      <BarChart data={data} margin={{ top: 4, right: 4, left: -20, bottom: 0 }} barCategoryGap="30%">
        <CartesianGrid strokeDasharray="3 3" stroke="oklch(0.88 0.015 268 / 0.5)" vertical={false} />
        <XAxis dataKey={xKey} tick={{ fontSize: 11, fontFamily: "JetBrains Mono", fill: "oklch(0.52 0.06 268)" }} axisLine={false} tickLine={false} />
        <YAxis tick={{ fontSize: 11, fontFamily: "JetBrains Mono", fill: "oklch(0.52 0.06 268)" }} axisLine={false} tickLine={false} />
        <Tooltip content={<CustomTooltip />} />
        {dataKeys.map((key, i) => (
          <Bar
            key={key}
            dataKey={key}
            fill={GRAIN_CHART_COLORS[i % GRAIN_CHART_COLORS.length]}
            radius={stacked ? [0, 0, 0, 0] : [6, 6, 0, 0]}
            stackId={stacked ? "stack" : undefined}
          />
        ))}
      </BarChart>
    </ResponsiveContainer>
  </div>
);

/* ── GrainLineChart ── */
export interface GrainLineChartProps extends React.HTMLAttributes<HTMLDivElement> {
  data: Record<string, unknown>[];
  dataKeys: string[];
  xKey: string;
  height?: number;
  title?: string;
}

export const GrainLineChart: React.FC<GrainLineChartProps> = ({
  data, dataKeys, xKey, height = 220, title, className, ...props
}) => (
  <div className={cn("w-full", className)} {...props}>
    {title && <p className="text-sm font-semibold font-body text-foreground mb-3">{title}</p>}
    <ResponsiveContainer width="100%" height={height}>
      <LineChart data={data} margin={{ top: 4, right: 4, left: -20, bottom: 0 }}>
        <CartesianGrid strokeDasharray="3 3" stroke="oklch(0.88 0.015 268 / 0.5)" vertical={false} />
        <XAxis dataKey={xKey} tick={{ fontSize: 11, fontFamily: "JetBrains Mono", fill: "oklch(0.52 0.06 268)" }} axisLine={false} tickLine={false} />
        <YAxis tick={{ fontSize: 11, fontFamily: "JetBrains Mono", fill: "oklch(0.52 0.06 268)" }} axisLine={false} tickLine={false} />
        <Tooltip content={<CustomTooltip />} />
        <Legend wrapperStyle={{ fontSize: 11, fontFamily: "Plus Jakarta Sans" }} />
        {dataKeys.map((key, i) => (
          <Line
            key={key}
            type="monotone"
            dataKey={key}
            stroke={GRAIN_CHART_COLORS[i % GRAIN_CHART_COLORS.length]}
            strokeWidth={2.5}
            dot={false}
            activeDot={{ r: 5, strokeWidth: 2, stroke: "white" }}
          />
        ))}
      </LineChart>
    </ResponsiveContainer>
  </div>
);

/* ── GrainDonutChart ── */
export interface GrainDonutChartProps extends React.HTMLAttributes<HTMLDivElement> {
  data: Array<{ name: string; value: number }>;
  height?: number;
  title?: string;
  innerLabel?: string;
  innerValue?: string | number;
}

export const GrainDonutChart: React.FC<GrainDonutChartProps> = ({
  data, height = 220, title, innerLabel, innerValue, className, ...props
}) => (
  <div className={cn("w-full", className)} {...props}>
    {title && <p className="text-sm font-semibold font-body text-foreground mb-3">{title}</p>}
    <ResponsiveContainer width="100%" height={height}>
      <PieChart>
        <Pie
          data={data}
          cx="50%"
          cy="50%"
          innerRadius="55%"
          outerRadius="80%"
          paddingAngle={3}
          dataKey="value"
          stroke="none"
        >
          {data.map((_, i) => (
            <Cell key={i} fill={GRAIN_CHART_COLORS[i % GRAIN_CHART_COLORS.length]} />
          ))}
        </Pie>
        <Tooltip content={<CustomTooltip />} />
        <Legend
          iconType="circle"
          iconSize={8}
          wrapperStyle={{ fontSize: 11, fontFamily: "Plus Jakarta Sans" }}
        />
        {innerLabel && innerValue !== undefined && (
          <text x="50%" y="50%" textAnchor="middle" dominantBaseline="middle">
            <tspan x="50%" dy="-0.4em" fontSize="20" fontWeight="700" fontFamily="Fraunces" fill="oklch(0.18 0.02 270)">
              {innerValue}
            </tspan>
            <tspan x="50%" dy="1.4em" fontSize="11" fontFamily="Plus Jakarta Sans" fill="oklch(0.52 0.06 268)">
              {innerLabel}
            </tspan>
          </text>
        )}
      </PieChart>
    </ResponsiveContainer>
  </div>
);
